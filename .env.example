# Copia este archivo como .env y cambia los valores. .env no se sube a git.

# Puerto donde escucha la API (muchos hostings lo ponen solos)
PORT=3000

# Conexión a PostgreSQL. En producción es obligatoria.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/vitta

# Secreto para firmar los tokens. En producción es obligatorio.
# Debe ser largo (32+ caracteres al azar) y propio de cada servidor; no uses este.
# Se puede generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR-POR-UN-SECRETO-LARGO

JWT_EXPIRES_IN=7d

# development en tu PC, production en el servidor
NODE_ENV=production
